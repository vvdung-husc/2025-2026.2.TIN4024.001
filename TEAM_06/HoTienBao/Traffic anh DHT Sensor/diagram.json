    { "type": "wokwi-dht22", "id": "dht", "top": 50, "left": 180, "attrs": {} },
    { "type": "wokwi-tm1637-7segment", "id": "disp", "top": -60, "left": 180, "attrs": {"color": "red"} },
    { "type": "wokwi-led", "id": "led", "top": 120, "left": -100, "attrs": {"color": "green"} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 20, "left": -100, "attrs": {"color": "green"} },
    { "type": "wokwi-resistor", "id": "r1", "top": 160, "left": -60, "attrs": {"value": "220"} }
