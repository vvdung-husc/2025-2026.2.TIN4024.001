    [ "esp:22", "disp:CLK", "blue", [ "v0" ] ],
    [ "esp:23", "disp:DIO", "green", [ "v0" ] ],
    [ "esp:5V", "disp:VCC", "red", [ "v0" ] ],
    [ "esp:GND", "disp:GND", "black", [ "v0" ] ],
    [ "esp:2", "led:A", "green", [ "v0" ] ],
    [ "led:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND", "black", [ "v0" ] ],
    [ "esp:4", "btn:1.l", "green", [ "v0" ] ],
    [ "btn:2.l", "esp:GND", "black", [ "v0" ] ]
