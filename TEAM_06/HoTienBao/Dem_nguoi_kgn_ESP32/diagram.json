{
  "version": 1,
  "author": "Hồ Tiến Bảo",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 30,
      "left": 200,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "sensor_a",
      "top": -80,
      "left": -200,
      "attrs": { "label": "Sensor A (Ngoai Cua)" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "sensor_b",
      "top": 100,
      "left": -200,
      "attrs": { "label": "Sensor B (Trong Cua)" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 180,
      "left": 230,
      "attrs": { "color": "yellow", "label": "Bao Hieu" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 220,
      "left": 130,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:21", "oled:SDA", "green", [ "h15", "v-60", "h180" ] ],
    [ "esp:22", "oled:SCL", "blue", [ "h25", "v-40", "h160" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "h-15", "v-90", "h240" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "h-25", "v-110", "h270" ] ],
    [ "sensor_a:VCC", "esp:3V3", "red", [ "v-30", "h150" ] ],
    [ "sensor_a:GND", "esp:GND.2", "black", [ "v20", "h150" ] ],
    [ "sensor_a:DO", "esp:18", "green", [ "v40", "h130" ] ],
    [ "sensor_b:VCC", "esp:3V3", "red", [ "v-30", "h130", "v-150" ] ],
    [ "sensor_b:GND", "esp:GND.2", "black", [ "v20", "h120", "v-50" ] ],
    [ "sensor_b:DO", "esp:19", "blue", [ "v40", "h160" ] ],
    [ "esp:27", "r1:1", "yellow", [ "h20", "v30" ] ],
    [ "r1:2", "led1:A", "yellow", [ "h10" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v20", "h-180", "v-20" ] ]
  ],
  "dependencies": {}
}