    [ "oled1:SDA", "esp:D2", "green", [] ],
    [ "oled1:SCL", "esp:D1", "blue", [] ],

    
    [ "esp:D4", "led1:A", "green", [] ],
    [ "led1:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.3", "black", [] ],

    
    [ "mq2:VCC", "esp:3V3", "red", [] ],
    [ "mq2:GND", "esp:GND.4", "black", [] ],
