{
  "version": 1,
  "author": "HoVanTanPhat",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led-status",
      "top": -60,
      "left": 100,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 10,
      "left": 100,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:2", "led-status:A", "green", [ "h30", "v-80" ] ],
    [ "led-status:C", "r1:1", "black", [ "v20" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v40", "h-40" ] ]
  ]
}